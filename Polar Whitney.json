{
  "name": "Polar Whitney",
  "style": "Dark",
  "version": "2.1",
  "author": {
    "name": "Postnumbers",
    "email": "post@postnumbers.com"
  },
  "editor": {
    "backgroundColor": "#2e3440",
    "altBackgroundColor": "#3b4252",
    "tintColor": "#8fbcbb",
    "tintColor2": "#88c0d0",
    "textColor": "#d8dee9",
    "toolbarBackgroundColor": "#2e3440",
    "toolbarIconColor": "#d8dee9",
    "menuItemColor": "#d8dee9",
    "timeBlockColor": "#81a1c1",
    "shouldOverwriteFont": false
  },
  "orderedStyles": [
    "narrow-blank-line",
    "narrower-blank-line",
    "repeat-tag",
    "repeat",
    "title-mark1",
    "title-mark2",
    "title-mark3",
    "title-mark4",
    "body",
    "quote-content",
    "bold",
    "bold-left-mark",
    "bold-right-mark",
    "italic",
    "italic-left-mark",
    "italic-right-mark",
    "boldItalic",
    "boldItalic-left-mark",
    "boldItalic-right-mark",
    "underline",
    "underline-left-tilde",
    "underline-right-tilde",
    "strikethrough",
    "strikethrough-left-tilde",
    "strikethrough-right-tilde",
    "critic-highlight",
    "critic-highlight-left-mark",
    "critic-highlight-right-mark",
    "highlighted",
    "highlighted-left-mark",
    "highlighted-right-mark",
    ":highlighted:",
    ":highlighted-left-mark:",
    ":highlighted-right-mark:",
    "addition",
    "addition-left-mark",
    "addition-right-mark",
    "deletion",
    "deletion-left-mark",
    "deletion-right-mark",
    "substitution-before",
    "substitution-after",
    "substitution-left-mark",
    "substitution-middle-mark",
    "substitution-right-mark",
    "comment",
    "comment-left-mark",
    "comment-right-mark",
    "flagged-1",
    "flagged-1-mark",
    "flagged-2",
    "flagged-2-mark",
    "flagged-3",
    "flagged-3-mark",
    "low-priority",
    "low-priority-mark",
    "working-on",
    "waiting-todo",
    "waiting-tag",
    "code",
    "code-left-backtick",
    "code-right-backtick",
    "checked-todo-characters",
    "todo",
    "checked",
    "checked-canceled",
    "checked-canceled-text",
    "checked-scheduled",
    "quote-mark",
    "tabbed",
    "link",
    "eventID",
    "URL-link",
    "URL-link-left-bracket",
    "URL-link-right-bracket",
    "URL-link-left-parenthesis",
    "URL-link-right-parenthesis",
    "note-title-link",
    "note-title-link-left-brackets",
    "note-title-link-right-brackets",
    "note-title-link-done",
    "note-title-link-cancelled-symbol",
    "note-title-link-cancelled-strikethrough",
    "arrow-link",
    "arrow-link-left-mark",
    "arrow-link-right-mark",
    "note-search-link",
    "note-search-link-left-mark",
    "note-search-link-right-mark",
    "hashtag-mark",
    "hashtag",
    "attag",
    "schedule-to-date-link",
    "done-date",
    "schedule-from-date-link",
    "Timeblock-hide-tag",
    "Timeblock-time-1",
    "Timeblock-time-separator",
    "Timeblock-time-2",
    "end-of-line-comment-hide",
    "end-of-line-comment-show",
    "end-of-line-comment-mark",
    "title1",
    "title2",
    "title3",
    "title4"
  ],
  "styles": {
    "body": {
      "font": "Whitney-Book",
      "color": "#d8dee9",
      "size": 18,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "tabbed": {
      "headIndent": 36
    },
    "narrow-blank-line": {
      "comment": "entering one space alone on a line reduces the line height",
      "regex": "(^\\ {1}$)",
      "size": 5,
      "paragraphSpacingBefore": 2,
      "paragraphSpacing": 2
    },
    "narrower-blank-line": {
      "comment": "entering two spaces alone on a line significantly reduces the line height",
      "regex": "(^\\ {2}$)",
      "size": 5,
      "paragraphSpacingBefore": -10,
      "paragraphSpacing": -5
    },
    "title1": {
      "font": "Whitney-Medium",
      "color": "#88c0d0",
      "size": 25
    },
    "title-mark1": {
      "color": "#616e88",
      "size": 25,
      "lineSpacing": -6,
      "paragraphSpacingBefore": 17,
      "paragraphSpacing": 7
    },
    "title2": {
      "font": "Whitney-Medium",
      "color": "#88c0d0",
      "size": 21
    },
    "title-mark2": {
      "color": "#616e88",
      "size": 21,
      "lineSpacing": -6,
      "paragraphSpacingBefore": 15.5,
      "paragraphSpacing": 4
    },
    "title3": {
      "font": "Whitney-Medium",
      "color": "#88c0d0",
      "size": 19
    },
    "title-mark3": {
      "color": "#616e88",
      "size": 19,
      "lineSpacing": -3.5,
      "paragraphSpacingBefore": 12,
      "paragraphSpacing": 4.5
    },
    "title4": {
      "font": "Whitney-Medium",
      "color": "#88c0d0",
      "size": 19
    },
    "title-mark4": {
      "color": "#616e88",
      "size": 19,
      "lineSpacing": -3.5,
      "paragraphSpacingBefore": 12,
      "paragraphSpacing": 5
    },
    "bold": {
      "font": "Whitney-Semibold"
    },
    "bold-left-mark": {
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "bold-right-mark": {
      "color": "#616e88"
    },
    "italic": {
      "font": "Whitney-MediumItalic",
      "color": "#d4d6ff"
    },
    "italic-left-mark": {
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "italic-right-mark": {
      "color": "#616e88"
    },
    "boldItalic": {
      "font": "Whitney-SemiboldItalic"
    },
    "boldItalic-left-mark": {
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "boldItalic-right-mark": {
      "color": "#616e88"
    },
    "underline": {
      "underlineStyle": 1,
      "underlineColor": "#81a1c1"
    },
    "underline-left-tilde": {
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "underline-right-tilde": {
      "color": "#616e88"
    },
    "strikethrough": {
      "regex": "(~~)([^~]*)(~~)",
      "matchPosition": 2,
      "color": "#616e88",
      "strikethroughStyle": 1,
      "strikethroughColor": "#616e88",
      "isRevealOnCursorRange": true
    },
    "strikethrough-left-tilde": {
      "regex": "(~~)([^~]*)(~~)",
      "matchPosition": 1,
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "strikethrough-right-tilde": {
      "regex": "(~~)([^~]*)(~~)",
      "matchPosition": 3,
      "color": "#616e88",
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "todo": {
      "comment": "color applied to todo marks, bullets, and list numbering",
      "font": "noteplanstate",
      "color": "#8fbcbb",
      "headIndent": 36,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "checked": {
      "comment": "styles text and todo mark for completed todos",
      "color": "#5e81ac",
      "headIndent": 36,
      "lineSpacing": 5.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "checked-todo-characters": {
      "comment": "styles the todo mark for completed todos",
      "font": "noteplanstate"
    },
    "checked-canceled": {
      "comment": "styles strikethrough line covering an entire cancelled todo",
      "regex": "(^\\h*[\\*\\-\\+] |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] ).*",
      "color": "#616e88",
      "strikethroughStyle": 1,
      "strikethroughColor": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "checked-canceled-text": {
      "comment": "styles text of a cancelled todo",
      "regex": "(?:(^\\h*[\\*\\-\\+] |^\\h*[0-9]+[\\.\\)] )(\\[\\-\\] ))(.*)",
      "matchPosition": 3,
      "color": "#616e88",
      "strikethroughStyle": 1,
      "strikethroughColor": "#616e88"
    },
    "checked-scheduled": {
      "comment": "styles text and todo mark for todos rescheduled to another date",
      "regex": "(^\\h*[\\*\\-\\+]{1} |^\\h*[0-9]+[\\.\\)] )(\\[\\>\\] ).*",
      "matchPosition": 0,
      "color": "#8a94c1",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "due-date": {
      "comment": "custom syntax for an optional due date with no link for a todo; format can be '@due()' with, or '!' followed by, the deadline expressed either as 'today', 'yesterday', 'tomorrow', or 'YYYY-MM-DD' and optionally followed by the time in 12 or 24-hour format (e.g., ' 14:35', ' 2:35 pm', ' 2:35PM', etc.)",
      "regex": "(?:\\h)(((@due\\()|!)((today|tomorrow|yesterday|(([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-9]|3[0-1])))(( ((0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]( ?[aApP][mM])?))?))(\\)?))(?=\\s|$)",
      "matchPosition": 0,
      "type": "nolink",
      "color": "#b48ead",
      "isRevealOnCursorRange": true
    },
    "due-date-mark-left": {
      "comment": "styles the '@due(' and '!' syntax, but not the due date",
      "regex": "(?:\\h)(((@due\\()|!)((today|tomorrow|yesterday|(([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-9]|3[0-1])))(( ((0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]( ?[aApP][mM])?))?))(\\)?))(?=\\s|$)",
      "matchPosition": 2,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "due-date-mark-right": {
      "comment": "styles the right parenthesis of the '@due()' syntax",
      "regex": "(?:\\h)(((@due\\()|!)((today|tomorrow|yesterday|(([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-9]|3[0-1])))(( ((0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]( ?[aApP][mM])?))?))(\\)?))(?=\\s|$)",
      "matchPosition": 15,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "schedule-to-date-link": {
      "comment": "linked start date for a todo - link colors are replaced by tintColor",
      "regex": "[>@](today|tomorrow|yesterday|(([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-9]|3[0-1])))( ((0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]( ?[aApP][mM])?))?",
      "matchPosition": 0,
      "urlPosition": 1,
      "type": "link",
      "prefix": "noteplan://x-callback-url/openNote?view=daily&noteDate=",
      "isRevealOnCursorRange": true
    },
    "schedule-to-date-mark": {
      "comment": "hides the syntax marking a start date (i.e., '>' or '@') - link colors are replaced by tintColor",
      "regex": "([>@])(today|tomorrow|yesterday|(([0-9]{4})-(0[1-9]|1[0-2])-(0[1-9]|1[0-9]|2[0-9]|3[0-1])))( ((0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]( ?[aApP][mM])?))?",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "schedule-from-date-link": {
      "comment": "linked date from which a todo had been rescheduled - link colors are replaced by tintColor"
    },
    "done-date": {
      "comment": "date the todo was completed",
      "color": "#5e81ac"
    },
    "flagged-1": {
      "comment": "styles todos marked as high priority",
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+)\\!{1}\\h+.*)($|\\v)",
      "matchPosition": 2,
      "backgroundColor": "#4e2c2f",
      "headIndent": 36,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "flagged-1-mark": {
      "comment": "styles priority mark for todos marked as high priority",
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+))(\\!{1})(\\h+.*)($|\\v)",
      "matchPosition": 5,
      "font": "Whitney-Semibold",
      "color": "#b48ead"
    },
    "flagged-2": {
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+)\\!{2}\\h+.*)($|\\v)",
      "matchPosition": 2,
      "backgroundColor": "#65393d",
      "headIndent": 36,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "flagged-2-mark": {
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+))(\\!{2})(\\h+.*)($|\\v)",
      "matchPosition": 5,
      "font": "Whitney-Semibold",
      "color": "#b48ead"
    },
    "flagged-3": {
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+)\\!{3}\\h+.*)($|\\v)",
      "matchPosition": 2,
      "font": "Whitney-Medium",
      "backgroundColor": "#7c4147",
      "headIndent": 36,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "flagged-3-mark": {
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+))(\\!{3})(\\h+.*)($|\\v)",
      "matchPosition": 5,
      "font": "Whitney-Semibold",
      "color": "#b48ead"
    },
    "low-priority": {
      "comment": "styles text of low-priority todos",
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+))(↓\\h+)(.*)($|\\v)",
      "matchPosition": 6,
      "color": "#81a1c1"
    },
    "low-priority-mark": {
      "comment": "styles low-priority marks for todos",
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+))(↓\\h+)(.*)($|\\v)",
      "matchPosition": 5,
      "font": "Whitney-Semibold",
      "color": "#737c9d",
      "headIndent": 36,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 4,
      "paragraphSpacing": 0
    },
    "working-on": {
      "comment": "styles text and mark (>>) of todos being worked on",
      "regex": "(^|\\v)(\\h*(\\*|-)\\h*(\\[ \\]\\h+|\\h+)\\>\\>\\h+.*)($|\\v)",
      "matchPosition": 2,
      "color": "#a3be8c",
      "backgroundColor": "#2e3440"
    },
    "waiting-todo": {
      "comment": "styles text of todos with a @waiting tag",
      "regex": "^\\* (.*\\@waiting.*)$",
      "matchPosition": 1,
      "font": "Whitney-BookItalic",
      "color": "#81a1c1"
    },
    "waiting-tag": {
      "comment": "styles linked @waiting tag - link colors are replaced by tintColor",
      "regex": "^\\* .*(\\@waiting.*)$",
      "matchPosition": 1,
      "type": "link",
      "prefix": "noteplan://x-callback-url/selectTag?name="
    },
    "repeat": {
      "comment": "styles repeat date determiner",
      "regex": "(?<=^|\\s)@repeat\\([^\\)]+\\)",
      "matchPosition": 0,
      "type": "nolink",
      "color": "#5e81ac",
      "isRevealOnCursorRange": true
    },
    "repeat-tag": {
      "comment": "hides @repeat tag to save space",
      "regex": "(?<=^|\\s)(@repeat)(\\([^\\)]+\\))",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "hashtag": {
      "comment": "hashtag symbol hidden to save space as identifiable as a hashtag via back-coloring; quick legibility not as important as visual de-emphasis as hashtags are primarily meant for computer searching and not visual searching",
      "regex": "(?<=^|\\s)(\\#[A-Za-z0-9\\-\\_\\/]+)",
      "matchPosition": 1,
      "color": "#5e81ac",
      "backgroundColor": "#2f4455",
      "borderRadius": 15,
      "leftBorderPadding": 5,
      "rightBorderPadding": 5,
      "horizontalMargin": 5,
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isRevealOnCursorRange": true
    },
    "hashtag-mark": {
      "comment": "hashtag mark hidden to save space",
      "regex": "(?<=^|\\s)(\\#)([A-Za-z0-9\\-\\_\\/]+)",
      "matchPosition": 1,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "attag": {
      "comment": "styles @attags apart from @repeat, @waiting, & @due as unlinked",
      "regex": "(?<=^|\\s)(@(?!(repeat|waiting|due))[^\\s]+)",
      "matchPosition": 1,
      "type": "nolink",
      "color": "#81a1c1",
      "backgroundColor": "#2e3440"
    },
    "link": {
      "comment": "styles text recognized as links, like URLs - link colors are replaced by tintColor",
      "font": "Whitney-Medium",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "phonenumber": {
      "comment": "link colors are replaced by tintColor, and this syntax is interpreted differently on iOS than on macOS and iPadOS"
    },
    "URL-link": {
      "comment": "markdown link description; link colors are replaced by tintColor; the following four syntaxes hide the URL and the accompanying parentheses and brackets",
      "regex": "\\[[^\\]]*?\\]\\(.*?\\)",
      "font": "Whitney-Medium",
      "isRevealOnCursorRange": true
    },
    "URL-link-left-bracket": {
      "regex": "(\\[)(.*?)(\\])(\\()(.*?)(\\))",
      "matchPosition": 1,
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": true
    },
    "URL-link-right-bracket": {
      "regex": "(\\[)(.*?)(\\])(\\()(.*?)(\\))",
      "matchPosition": 3,
      "color": "#616e88",
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": true
    },
    "URL-link-left-parenthesis": {
      "regex": "(\\[)(.*?)(\\])(\\()(.*?)(\\))",
      "matchPosition": 4,
      "color": "#616e88",
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": true
    },
    "URL-link-right-parenthesis": {
      "regex": "(\\[)(.*?)(\\])(\\()(.*?)(\\))",
      "matchPosition": 6,
      "color": "#616e88",
      "isHiddenWithoutCursor": true,
      "isMarkdownCharacter": true
    },
    "note-title-link": {
      "comment": "NotePlan note title link; link colors are replaced by tintColor",
      "regex": "(\\[\\[)(.*?)(\\]\\])",
      "matchPosition": 2,
      "font": "Whitney-Medium"
    },
    "note-title-link-left-brackets": {
      "regex": "(\\[\\[)(.*?)(\\]\\])",
      "matchPosition": 1,
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "note-title-link-right-brackets": {
      "regex": "(\\[\\[)(.*?)(\\]\\])",
      "matchPosition": 3,
      "color": "#616e88"
    },
    "note-title-link-done": {
      "regex": "(?:^|\\h)(x\\[\\[)(.*?)(\\]\\])",
      "matchPosition": 1,
      "font": "noteplanstate",
      "color": "#5e81ac",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isMarkdownCharacter": true,
      "isRevealOnCursorRange": true
    },
    "note-title-link-cancelled-symbol": {
      "comment": "formats just the symbol in front of the note title link",
      "regex": "(?:^|\\h)(-)(\\[\\[)(.*?)(\\]\\])",
      "matchPosition": 1,
      "font": "noteplanstate",
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": true,
      "isRevealOnCursorRange": true
    },
    "note-title-link-cancelled-strikethrough": {
      "comment": "strikes through the note title and the cancelled symbol, and deactivates the note title link",
      "regex": "(?:^|\\h)(-\\[\\[.*?\\]\\])",
      "type": "nolink",
      "strikethroughStyle": 1,
      "strikethroughColor": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0
    },
    "arrow-link": {
      "comment": "link colors are replaced by tintColor",
      "regex": "(?<=^|\\s)>(\\S[^<]*?)<[$\\s\\b\\.\\)\\]\\}]",
      "matchPosition": 1,
      "urlPosition": 1,
      "type": "noteLink",
      "prefix": "noteplan://x-callback-url/openNote?noteTitle=",
      "font": "Whitney-Medium",
      "isRevealOnCursorRange": true
    },
    "arrow-link-left-mark": {
      "regex": "(?<=^|\\s)(>)(\\S[^<]*?)(<)",
      "matchPosition": 1,
      "color": "#616e88",
      "lineSpacing": 4.5,
      "paragraphSpacingBefore": 13,
      "paragraphSpacing": 0,
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": false,
      "isRevealOnCursorRange": true
    },
    "arrow-link-right-mark": {
      "regex": "(?<=^|\\s)(>)(\\S[^<]*?)(<)",
      "matchPosition": 3,
      "color": "#616e88",
      "isMarkdownCharacter": true,
      "isHiddenWithoutCursor": false,
      "isRevealOnCursorRange": true
    },
    "note-search-link": {
      "comment": "link colors are replaced by tintColor",
      "regex": "(\\/{2})(\\S[^/]*\\S)(\\/{2})",
      "matchPosition": 2,
      "urlPosition": 2,
      "type": "link",
